---
import { t, garments } from '../i18n';
import type { Lang } from '../site';
interface Props { lang: Lang }
const { lang } = Astro.props;
const s = t[lang];
const slots = (['top', 'layer', 'bottom'] as const).map((key) => ({
  key,
  label: s.slots[key],
  items: garments[key].map((g) => ({ id: g.id, name: g[lang] })),
}));
const swapWord = lang === 'en' ? 'tap to swap' : 'klepni pro výměnu';
---
<figure class="canvas" data-canvas data-swap={swapWord}>
  <div class="canvas__board" role="group" aria-label={s.hero.canvasLabel}>
    {slots.map((slot) => (
      <button
        type="button"
        class={`piece piece--${slot.key}`}
        data-slot={slot.key}
        data-label={slot.label}
        data-items={JSON.stringify(slot.items)}
        data-index="0"
        aria-label={`${slot.label}: ${slot.items[0].name}, ${swapWord}`}
      >
        <img src={`/clothes/${slot.items[0].id}.webp`} alt="" width="480" height="480" loading="eager" decoding="async" />
      </button>
    ))}
  </div>
  <figcaption class="canvas__bar">
    <span aria-live="polite" data-status>{s.hero.hint}</span>
    <button type="button" class="shuffle" data-shuffle>
      <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M16 3h5v5M4 20 21 3M21 16v5h-5M15 15l6 6M4 4l5 5" /></svg>
      {s.hero.shuffle}
    </button>
  </figcaption>
</figure>

<style>
  .canvas { margin: 0; }
  .canvas__board {
    position: relative;
    aspect-ratio: 5 / 6;
    background: var(--ink);
    border-radius: clamp(22px, 3vw, 34px);
    overflow: hidden;
  }
  .piece {
    position: absolute;
    width: 46%;
    aspect-ratio: 1;
    padding: 0;
    border: 0;
    border-radius: 9%;
    background: #fff;
    cursor: pointer;
    box-shadow: 0 18px 40px -18px rgb(0 0 0 / 0.7);
    transition: transform 0.35s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .piece img { width: 100%; height: 100%; border-radius: inherit; object-fit: contain; }
  .piece--top    { left: 9%;  top: 6%;  transform: rotate(-3deg); z-index: 1; }
  .piece--layer  { left: 47%; top: 27%; transform: rotate(2.5deg); z-index: 2; }
  .piece--bottom { left: 13%; top: 50%; transform: rotate(-1.5deg); z-index: 1; }
  .piece:hover { transform: rotate(0deg) scale(1.02); }
  .piece:focus-visible { outline: 3px solid var(--lagoon); outline-offset: 4px; }
  .piece.is-swapping img { animation: swap 0.32s ease; }
  @keyframes swap { 0% { opacity: 0; transform: scale(0.92); } 100% { opacity: 1; transform: scale(1); } }
  @media (prefers-reduced-motion: reduce) {
    .piece, .piece:hover { transition: none; }
    .piece.is-swapping img { animation: none; }
  }

  .canvas__bar { display: flex; align-items: center; justify-content: space-between; gap: 1rem; margin-top: 0.9rem; font-size: var(--step--1); color: var(--muted); }
  /* One line, whatever got picked: a status that wraps to two lines makes the
     canvas taller, and the hero (centered beside it) jumps. Screen readers
     still get the full text from aria-live. */
  [data-status] { flex: 1; min-width: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  /* Phones: too narrow for one line. Two lines, always reserved, so the
     content below doesn't jump either. */
  @media (max-width: 600px) {
    [data-status] {
      white-space: normal; display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2;
      line-height: 1.35; min-height: 2.7em;
    }
  }
  .shuffle {
    display: inline-flex; align-items: center; gap: 0.5em; flex: none;
    min-height: 2.6rem; padding: 0 1.1rem; border-radius: 999px;
    border: 1.5px solid var(--ink); background: transparent; color: var(--ink);
    font: 600 0.95rem/1 var(--sans); cursor: pointer;
  }
  .shuffle { transition: color 0.2s ease, background-color 0.2s ease, transform 0.08s ease; }
  .shuffle:hover { background: var(--ink); color: var(--paper); }
  .shuffle svg { width: 1.05em; height: 1.05em; transition: rotate 0.4s cubic-bezier(0.2, 0.8, 0.2, 1); }
  @media (prefers-reduced-motion: no-preference) {
    .shuffle:hover svg { rotate: 180deg; }
    .shuffle:active { transform: scale(0.97); }
  }
</style>

<script>
  type Item = { id: string; name: string };
  for (const root of document.querySelectorAll<HTMLElement>('[data-canvas]')) {
    const swapWord = root.dataset.swap ?? '';
    const status = root.querySelector<HTMLElement>('[data-status]');
    const pieces = [...root.querySelectorAll<HTMLButtonElement>('.piece')];

    // preload every garment so swaps are instant
    for (const p of pieces) for (const it of JSON.parse(p.dataset.items!) as Item[]) {
      const img = new Image(); img.src = `/clothes/${it.id}.webp`;
    }

    const show = (p: HTMLButtonElement, index: number) => {
      const items = JSON.parse(p.dataset.items!) as Item[];
      const i = ((index % items.length) + items.length) % items.length;
      p.dataset.index = String(i);
      p.querySelector('img')!.src = `/clothes/${items[i].id}.webp`;
      p.setAttribute('aria-label', `${p.dataset.label}: ${items[i].name}, ${swapWord}`);
      p.classList.remove('is-swapping'); void p.offsetWidth; p.classList.add('is-swapping');
      return items[i].name;
    };

    for (const p of pieces) {
      p.addEventListener('click', () => {
        const name = show(p, Number(p.dataset.index) + 1);
        if (status) status.textContent = `${p.dataset.label}: ${name}`;
      });
    }

    root.querySelector('[data-shuffle]')?.addEventListener('click', () => {
      const names = pieces.map((p) => {
        const n = (JSON.parse(p.dataset.items!) as Item[]).length;
        let next = Math.floor(Math.random() * n);
        if (next === Number(p.dataset.index)) next += 1;
        return show(p, next);
      });
      if (status) status.textContent = names.join(', ');
    });
  }
</script>
